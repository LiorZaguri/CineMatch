PORT=3000
NODE_ENV=development

JWT_SECRET=<your_jwt_secret_here>
JWT_EXPIRES_IN=1h

POSTGRES_USER=cinematch_users_admin
POSTGRES_PASSWORD=<your_postgres_password_here>
POSTGRES_DB=cinematch_users_db
POSTGRES_HOST=users-db
POSTGRES_PORT=5433

DATABASE_URL=postgresql://cinematch_users_admin:<your_postgres_password_here>@users-db:5433/cinematch_users_db?schema=public

CORE_SERVICE_URL=http://cinematch-core:8000

S3_INTERNAL_ENDPOINT_URL=http://s3-storage:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minio_admin
S3_SECRET_ACCESS_KEY=<your_minio_password_here>
S3_BUCKET_NAME=cinematch-avatars
S3_REGION=us-east-1

# RabbitMQ
RABBITMQ_USER=rmq_admin
RABBITMQ_PASSWORD=<your_rabbitmq_password_here>
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Core Env
POSTGRES_USER=cinematch_movies_admin
POSTGRES_PASSWORD=<your_postgres_password_here>
POSTGRES_DB=cinematch_movies_db
POSTGRES_HOST=movies-db
POSTGRES_PORT=5432

# S3 / minIO 
S3_ENDPOINT_URL=http://s3-storage:9000
S3_ACCESS_KEY_ID=minio_admin
S3_SECRET_ACCESS_KEY=<your_minio_password_here>
S3_BUCKET_NAME=cinematch-posters
S3_REGION=us-east-1

# RabbitMQ
RABBITMQ_USER=rmq_admin
RABBITMQ_PASSWORD=<your_rabbitmq_password_here>
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
AI_RECOMMENDATION_QUEUE=ai.search.request
AI_REVIEW_SUMMARIZER_QUEUE=ai.review.summary.request

# TMDB
TMDB_READ_ACCESS_TOKEN=<your_tmdb_read_access_token_here>

# CORS Settings: Comma-separated list of origins allowed to make requests.
ALLOWED_ORIGINS=http://localhost,http://localhost:4200,http://localhost:3001
